DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
ML_SERVICE_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional: leave the key/model blank to use extractive notes and chat.
# OpenAI uses the default base URL. For Gemini, set the base URL to
# https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash

# Optional: recall-aware RAG heuristic weights (each 0.0–1.0).
RAG_STATE_GAP_WEIGHT=0.30
RAG_STATE_RECENCY_WEIGHT=0.15
RAG_DIRECT_QUESTION_STATE_SCALE=0.25
